{
	"name": "codelink",
	"displayName": "CodeLink",
	"description": "",
	"version": "1.0.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/mderu/LinkWheel/"
	},
	"engines": {
		"vscode": "^1.85.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [
	],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "codelink.linkLine",
				"title": "Copy Link to Line Number"
			}
		],
		"menus": {
			"editor/context": [
				{
					"command": "codelink.linkLine",
					"group": "navigation"
				}
			]
		}
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"pretest": "npm run compile && npm run lint",
		"lint": "eslint src --ext ts",
		"test": "node ./out/test/runTest.js"
	},
	"devDependencies": {
		"@types/glob": "^7.1.4",
		"@types/mocha": "^9.0.0",
		"@types/node": "14.x",
		"@types/vscode": "^1.85.0",
		"@typescript-eslint/eslint-plugin": "^4.31.1",
		"@typescript-eslint/parser": "^4.31.1",
		"@vscode/test-electron": "^2.5.2",
		"eslint": "^7.32.0",
		"glob": "^7.1.7",
		"mocha": "^11.7.5",
		"typescript": "^4.4.3"
	}
}
